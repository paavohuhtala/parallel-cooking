{
  /* The e2e project. It runs in Node (through Playwright's own transform) and
     drives a browser, so it needs both the DOM lib (for `page.evaluate`) and
     node types. It reaches into `src` for types only — `verbatimModuleSyntax`
     makes those imports erase, so nothing from the app is loaded at runtime. */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["e2e-tests", "playwright.config.ts"],
  /* `composite` wants every file it type-checks listed, so the two app modules
     the tests take types from are named here. Keeping it to a list rather than
     a directory is what stops the e2e project from quietly growing an
     understanding of the app's internals. */
  "files": ["src/model/types.ts", "src/shared/api.ts"]
}
