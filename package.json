{
  "name": "parallel-cooking",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test \"src/**/*.test.ts\"",
    "check:bundle": "grep -rlq ZodDiscriminatedUnion dist/assets/ && (echo 'zod leaked into the client bundle' && exit 1) || echo 'bundle clean'",
    "dev:server": "node --watch src/server/main.ts",
    "start": "node src/server/main.ts",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-router": "^1.170.33",
    "hono": "^4.13.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
